default_platform(:ios)

platform :ios do
  before_all do
    setup_ci # temp keychain on CI
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )
  end

  desc "Signed IPA -> TestFlight"
  lane :beta do
    build
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Signed IPA -> App Store Connect (not submitted for review)"
  lane :release do
    build
    deliver(
      submit_for_review: false,
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end

  def build
    match(type: "appstore")
    build_app(
      workspace: "NOpsApp.xcworkspace",
      scheme: "NOpsApp",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['GITHUB_RUN_NUMBER'] || 1}"
    )
  end
end
